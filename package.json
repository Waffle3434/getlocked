{
  "name": "getlocked-monorepo",
  "private": true,
  "license": "GPL-3.0-only",
  "workspaces": [
    "packages/protocol",
    "apps/desktop",
    "extension"
  ],
  "scripts": {
    "dev": "npm run ext:build && npm run tauri dev -w apps/desktop",
    "build": "npm run ext:build && npm run tauri build -w apps/desktop",
    "ext:build": "npm run build -w extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
